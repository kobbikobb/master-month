# Kinde Auth Configuration
# Get these values from your Kinde dashboard: https://app.kinde.com/
# Create a new application and copy the credentials below

# Required
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_DOMAIN=https://yourdomain.kinde.com

# Optional: Override redirect URIs (only needed if different from defaults)
# For local development:
# KINDE_REDIRECT_URI=http://localhost:5173/callback
# KINDE_LOGOUT_URI=http://localhost:5173

# For production, SST will automatically use your deployed domain
# KINDE_REDIRECT_URI=https://your-app.com/callback
# KINDE_LOGOUT_URI=https://your-app.com
